# Security headers for every static page and file.
# The Worker (src/worker.js) adds the same headers to the responses it makes.
# The script-src hash allows the one inline script on each page:
#   document.documentElement.classList.add('js');
# Cloudflare Web Analytics is allowed: Cloudflare adds its script to every page
# (static.cloudflareinsights.com) and it reports to cloudflareinsights.com.
# If you change the inline script, or add another outside service (chat,
# embeds), update the Content-Security-Policy or the browser will block it.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw=' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://cloudflareinsights.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Font file names change whenever the font changes, so browsers can keep them.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=86400

/videos/*
  Cache-Control: public, max-age=86400

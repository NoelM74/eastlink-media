{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eastlink-media",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Limits each visitor to 5 contact form messages a minute (see src/worker.js)
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
